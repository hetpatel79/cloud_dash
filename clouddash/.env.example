# Primary: Groq for fast LLM inference (Agents & Guardrails)
GROQ_API_KEY=

# Secondary: NVIDIA NIM for Embeddings & Reranking. https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_API_BASE=
# Same as NVIDIA_API_BASE if you prefer this name:
NVIDIA_BASE_URL=

# Optional: OpenAI Cloud when NVIDIA_API_KEY is not set.
# OPENAI_API_KEY=sk-...

# Optional: cap hung Swagger / UI waits (seconds, default 120)
LLM_REQUEST_TIMEOUT_SEC=120

QDRANT_URL=
QDRANT_API_KEY=
LOG_LEVEL=INFO
ENVIRONMENT=development
