# ═══════════════════════════════════════════════════════════
# CloudDash Support — .gitignore
# ═══════════════════════════════════════════════════════════

# ─── Secrets & Environment ──────────────────────────────────
# NEVER commit API keys. Use .env.example as the safe template.
.env
.env.local
.env.*.local
*.pem
*.key
secrets/

# ─── Python ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
wheels/
pip-wheel-metadata/
share/python-wheels/
MANIFEST

# ─── Virtual Environments ────────────────────────────────────
.venv/
venv/
env/
ENV/
.env/
.venv.bak/
venv.bak/
.pyenv/

# ─── Testing & Coverage ──────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover
*.py,cover
nosetests.xml
test-results/
junit.xml

# ─── Type Checking ───────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
.pyre/

# ─── Generated / Runtime Artifacts ──────────────────────────
# BM25 index — regenerated by `python -m knowledge_base.ingest`
knowledge_base/bm25_index.pkl

# Qdrant local data (only relevant if using on-disk mode)
qdrant_data/
qdrant_storage/

# Logs — runtime output, not source
logs/*.jsonl
logs/*.log
logs/*.txt

# ─── Scratch / Dev Scripts ───────────────────────────────────
# One-off debugging scripts; not part of the codebase
scratch/

# ─── IDE & Editor ────────────────────────────────────────────
.vscode/
.idea/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace
.spyproject
.spyderproject

# ─── OS Files ────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── Jupyter Notebooks ───────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ─── Distribution / Packaging ────────────────────────────────
.Python
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# ─── Documentation builds ────────────────────────────────────
docs/_build/
site/

# ─── LangChain / LangSmith ───────────────────────────────────
# Local tracing data written by LangSmith SDK
.langchain/
langchain.db

# ─── Temporary files ─────────────────────────────────────────
*.tmp
*.bak
*.swp
*.swo
*~
.~lock.*
